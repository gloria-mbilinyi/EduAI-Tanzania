        <mxCell id="59" value="Exposed interfaces: JSON REST /api, bearer JWT authentication, scoped report CSV downloads and authorized material downloads. Database and simulated provider adapters have no direct browser interface." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#365b4b;fontColor=#19382e;fontFamily=Arial;fontSize=17;fontStyle=0;spacing=6;align=left;" vertex="1" parent="1">
